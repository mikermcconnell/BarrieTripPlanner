rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==================== HELPER FUNCTIONS ====================

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user owns this resource
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Validate that a field is a string with content
    function isNonEmptyString(field) {
      return field is string && field.size() > 0;
    }

    // Validate email format (basic check)
    function isValidEmail(email) {
      return email is string && email.matches('.*@.*\\..*');
    }

    function isValidSharedTripPoint(point) {
      return point is map
        && point.keys().hasOnly(['name', 'addressText', 'lat', 'lon'])
        && isNonEmptyString(point.name)
        && point.name.size() <= 200
        && point.addressText is string
        && point.addressText.size() <= 500
        && point.lat is number
        && point.lon is number;
    }

    function isValidSharedTripPayload(trip) {
      return trip is map
        && trip.keys().hasOnly(['id', 'name', 'icon', 'from', 'to', 'timePreference', 'summary', 'isPinned'])
        && isNonEmptyString(trip.id)
        && trip.id.size() <= 500
        && isNonEmptyString(trip.name)
        && trip.name.size() <= 200
        && trip.icon is string
        && trip.icon.size() <= 50
        && isValidSharedTripPoint(trip.from)
        && isValidSharedTripPoint(trip.to)
        && trip.isPinned is bool;
    }

    function isValidSharedTripDocument(data, shareId) {
      return data.keys().hasOnly([
          'shareId', 'trip', 'createdBy', 'lastEditedBy', 'revision', 'createdAt', 'updatedAt'
        ])
        && data.shareId == shareId
        && isValidSharedTripPayload(data.trip)
        && isNonEmptyString(data.createdBy)
        && isNonEmptyString(data.lastEditedBy)
        && data.revision is int
        && data.revision > 0;
    }

    // ==================== USERS COLLECTION ====================

    match /users/{userId} {
      // Users can only read/write their own profile
      allow read: if isAuthenticated() && isOwner(userId);

      // Allow create only if user is creating their own profile
      allow create: if isAuthenticated()
        && isOwner(userId)
        && request.resource.data.uid == userId
        && isValidEmail(request.resource.data.email);

      // Allow update only for own profile, and can't change uid
      allow update: if isAuthenticated()
        && isOwner(userId)
        && request.resource.data.uid == resource.data.uid;

      // Users cannot delete their own profile (admin only)
      allow delete: if false;

      // ==================== FAVORITE STOPS ====================

      match /favoriteStops/{stopId} {
        // User can read their own favorite stops
        allow read: if isAuthenticated() && isOwner(userId);

        // User can add favorite stops
        allow create: if isAuthenticated()
          && isOwner(userId)
          && isNonEmptyString(request.resource.data.id)
          && isNonEmptyString(request.resource.data.name);

        // User can update their favorite stops
        allow update: if isAuthenticated() && isOwner(userId);

        // User can remove favorite stops
        allow delete: if isAuthenticated() && isOwner(userId);
      }

      // ==================== FAVORITE ROUTES ====================

      match /favoriteRoutes/{routeId} {
        // User can read their own favorite routes
        allow read: if isAuthenticated() && isOwner(userId);

        // User can add favorite routes
        allow create: if isAuthenticated()
          && isOwner(userId)
          && isNonEmptyString(request.resource.data.id);

        // User can update their favorite routes
        allow update: if isAuthenticated() && isOwner(userId);

        // User can remove favorite routes
        allow delete: if isAuthenticated() && isOwner(userId);
      }

      // ==================== TRIP HISTORY ====================

      match /tripHistory/{tripId} {
        // User can read their own trip history
        allow read: if isAuthenticated() && isOwner(userId);

        // User can add to trip history
        allow create: if isAuthenticated()
          && isOwner(userId)
          && request.resource.data.from != null
          && request.resource.data.to != null;

        // User can update trip history entries
        allow update: if isAuthenticated() && isOwner(userId);

        // User can delete trip history entries
        allow delete: if isAuthenticated() && isOwner(userId);
      }

      // ==================== SAVED PLACES ====================

      match /savedPlaces/{placeId} {
        // User can read their own saved places
        allow read: if isAuthenticated() && isOwner(userId);

        // User can create saved places
        allow create: if isAuthenticated()
          && isOwner(userId)
          && isNonEmptyString(request.resource.data.id)
          && isNonEmptyString(request.resource.data.name)
          && request.resource.data.lat is number
          && request.resource.data.lon is number;

        // User can update their saved places
        allow update: if isAuthenticated() && isOwner(userId);

        // User can delete their saved places
        allow delete: if isAuthenticated() && isOwner(userId);
      }

      // ==================== SAVED TRIPS (Future Feature) ====================

      match /savedTrips/{tripId} {
        // User can read their own saved trips
        allow read: if isAuthenticated() && isOwner(userId);

        // User can create saved trips
        allow create: if isAuthenticated()
          && isOwner(userId)
          && isNonEmptyString(request.resource.data.name)
          && request.resource.data.from != null
          && request.resource.data.to != null;

        // User can update their saved trips
        allow update: if isAuthenticated() && isOwner(userId);

        // User can delete their saved trips
        allow delete: if isAuthenticated() && isOwner(userId);
      }

      match /pushTokens/{deviceId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow create, update: if isAuthenticated()
          && isOwner(userId)
          && request.resource.data.deviceId == deviceId
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.token.size() <= 512;
        allow delete: if isAuthenticated() && isOwner(userId);
      }
    }

    // Shared trips use an unguessable document ID as the collaboration link.
    // Exact-link reads are public, collection listing is denied, and writes use
    // an invisible Firebase identity so riders never face a sign-in screen.
    match /sharedTrips/{shareId} {
      allow get: if true;
      allow list: if false;

      allow create: if isAuthenticated()
        && isValidSharedTripDocument(request.resource.data, shareId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.lastEditedBy == request.auth.uid
        && request.resource.data.revision == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isAuthenticated()
        && isValidSharedTripDocument(request.resource.data, shareId)
        && request.resource.data.shareId == resource.data.shareId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.lastEditedBy == request.auth.uid
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.updatedAt == request.time;

      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }

    // ==================== ACTIVE DETOURS (V2) ====================

    // Server-side detour detection writes via Admin SDK.
    // All app users can read; direct client writes denied.
    match /activeDetours/{routeId} {
      allow read: if true;
      allow write: if false;
    }

    // Persistent detour event history written by backend worker.
    // Public read enables clients/admin tools to inspect timeline history.
    match /detourHistory/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    // Lab V2 detour feed isolated from the production V1 feed.
    match /activeDetoursV2/{routeId} {
      allow read: if true;
      allow write: if false;
    }

    match /detourHistoryV2/{eventId} {
      allow read: if true;
      allow write: if false;
    }


    match /activeDetourEventsV2/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    match /detourEventHistoryV2/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    // Local detector output is isolated from the production rider feed. Dev
    // builds must opt into this collection explicitly.
    match /devActiveDetourEventsV2/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    match /devDetourEventHistoryV2/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    // Audited operator reviews are read and written only through the API proxy
    // using Firebase Admin. Rider clients have no direct access.
    match /detourOperatorReviews/{reviewId} {
      allow read, write: if false;

      match /revisions/{revisionId} {
        allow read, write: if false;
      }
    }

    match /detourPushNotifications/{notificationId} {
      allow read, write: if false;
    }

    match /pushNotificationReceipts/{receiptId} {
      allow read, write: if false;
    }

    // App feedback is submitted and reviewed only through the authenticated API
    // proxy. Direct client access is denied, including for administrator clients.
    match /appFeedback/{feedbackId} {
      allow read, write: if false;
    }

    match /appFeedbackRateLimits/{quotaId} {
      allow read, write: if false;
    }

    // ==================== TRANSIT NEWS ====================

    // Backend news worker writes via Admin SDK.
    // All app users can read; direct client writes denied.
    match /transitNews/{newsId} {
      allow read: if true;
      allow write: if false;
    }

    // Parsed rider-facing impacts from transit news, such as stop closures.
    match /transitNewsImpacts/{impactId} {
      allow read: if true;
      allow write: if false;
    }

    // Reviewed official service impacts, such as long-term GTFS-backed detours.
    match /officialServiceImpacts/{impactId} {
      allow read: if true;
      allow write: if false;
    }

    // ==================== ON-DEMAND ZONES ====================

    // Public rider-facing zone metadata. Backend/admin tooling writes via Admin SDK.
    match /onDemandZones/{zoneId} {
      allow read: if true;
      allow write: if false;
    }

    // ==================== PUBLIC DETOUR FEED (Legacy) ====================

    // Backend worker writes shared detours with Admin SDK.
    // Client apps can read these publicly; direct client writes are denied.
    match /publicDetoursActive/{detourId} {
      allow read: if true;
      allow write: if false;
    }

    // Public system metadata documents (detour feed health/counters)
    match /publicSystem/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ==================== DENY ALL OTHER ACCESS ====================

    // Catch-all rule to deny access to any other documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
